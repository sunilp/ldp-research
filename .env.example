# LDP Research — Environment Variables
#
# Copy to .env and fill in your keys:
#   cp .env.example .env

# ── Google Gemini (for judge model — cheapest cloud option) ──────────────
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# ── Ollama (local inference — free) ──────────────────────────────────────
# Default: http://localhost:11434 (no change needed if using standard install)
# OLLAMA_HOST=http://localhost:11434

# ── Anthropic (optional — for full experiment config) ────────────────────
# ANTHROPIC_API_KEY=

# ── OpenAI (optional — for full experiment config) ───────────────────────
# OPENAI_API_KEY=

# ── JamJet (optional — for runtime-integrated experiments) ───────────────
# JAMJET_TOKEN=
